{
  "name": "escutcheon",
  "version": "0.0.4",
  "description": "Launch a tool from a host app into a separate origin, borrowing the signed-in user's session: a signed cross-origin launch token plus a postMessage proxy for the host's own API, so the tool holds no server-side credential.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1qh/escutcheon.git"
  },
  "license": "Apache-2.0",
  "author": "1qh",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./launch": {
      "types": "./dist/launch.d.mts",
      "default": "./dist/launch.mjs"
    },
    "./opener": {
      "types": "./dist/opener.d.mts",
      "default": "./dist/opener.mjs"
    },
    "./proxy": {
      "types": "./dist/proxy.d.mts",
      "default": "./dist/proxy.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "postpublish": "bun ../../tools/prune-versions.ts"
  },
  "dependencies": {
    "zod": "latest"
  }
}
